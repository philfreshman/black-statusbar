{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "cleanUrls": true,
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
            "destination": "https://nightbar.app/:path*",
            "permanent": false
        },
        {
            "source": "/download",
            "destination": "https://github.com/philfreshman/nightbar/releases/latest/download/Nightbar.zip",
            "permanent": false
        },
        {
            "source": "/github",
            "destination": "https://github.com/philfreshman/nightbar",
            "permanent": false
        }
    ],
    "headers": [
        {
            "source": "/install.sh",
            "headers": [
                { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
                { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "X-Frame-Options", "value": "DENY" }
            ]
        }
    ]
}
