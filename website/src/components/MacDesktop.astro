---
/**
 * A MacBook screen showing a desktop with the notch and the menu bar.
 *
 * The menu bar is transparent by default, like on macOS 26, so it shows dark
 * icons over the light wallpaper. When the page's Nightbar switch is on, a black
 * strip slides in behind it and the icons turn white, which is what the app does.
 * The switch state reaches this component through `:has()` on the page.
 */
const menus = ["File", "Edit", "View", "Go", "Window", "Help"];
const dockTiles = [
  "finder", "safari", "messages", "mail", "maps", "photos", "facetime", "calendar",
  "notes", "music", "tv", "appstore", "nightbar", "settings",
];
---

<figure class="mac" aria-label="A Mac desktop with the menu bar at the top">
  <div class="lid">
    <div class="display">
      <div class="wallpaper" aria-hidden="true">
        <svg class="hills" viewBox="0 0 1600 1000" preserveAspectRatio="none">
          <path class="hill far" d="M0 640C180 600 330 650 520 620S860 540 1040 580S1380 640 1600 600V1000H0Z" />
          <path class="hill near" d="M0 780C200 750 380 790 600 770S940 700 1140 740S1460 780 1600 760V1000H0Z" />
        </svg>
      </div>

      <div class="menubar" aria-hidden="true">
        <div class="strip"></div>
        <div class="menus">
          <span class="app">Finder</span>
          {menus.map((name, i) => <span class={`menu menu-${i}`}>{name}</span>)}
        </div>
        <div class="notch"></div>
        <div class="extras">
          <svg class="icon nightbar" viewBox="0 0 20 16">
            <rect x="1.85" y="1.85" width="16.3" height="12.3" rx="2.55" fill="none" stroke="currentColor" stroke-width="1.7" />
            <path d="M1 4.4C1 2.5 2.5 1 4.4 1h11.2C17.5 1 19 2.5 19 4.4v1.2H1z" fill="currentColor" />
          </svg>
          <svg class="icon battery" viewBox="0 0 27 13">
            <rect x="0.75" y="0.75" width="22.5" height="11.5" rx="3.4" fill="none" stroke="currentColor" stroke-width="1.3" opacity="0.45" />
            <rect x="2.4" y="2.4" width="15.6" height="8.2" rx="2" fill="currentColor" />
            <path d="M24.8 4.4c.9.3 1.5 1.1 1.5 2.1s-.6 1.8-1.5 2.1z" fill="currentColor" opacity="0.45" />
          </svg>
          <svg class="icon wifi" viewBox="0 0 18 14">
            <path d="M9 13.2 6.6 10.6a3.4 3.4 0 0 1 4.8 0z" fill="currentColor" />
            <path d="M3.9 7.9a7.3 7.3 0 0 1 10.2 0M1.2 5a11.1 11.1 0 0 1 15.6 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
          </svg>
          <svg class="icon search" viewBox="0 0 16 16">
            <circle cx="6.6" cy="6.6" r="5" fill="none" stroke="currentColor" stroke-width="1.7" />
            <path d="m10.4 10.4 4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <svg class="icon control" viewBox="0 0 18 14">
            <rect x="0.8" y="0.8" width="16.4" height="5.2" rx="2.6" fill="none" stroke="currentColor" stroke-width="1.4" />
            <circle cx="14.6" cy="3.4" r="1.6" fill="currentColor" />
            <rect x="0.8" y="8" width="16.4" height="5.2" rx="2.6" fill="currentColor" />
            <circle cx="3.4" cy="10.6" r="1.6" class="knob" />
          </svg>
          <time class="clock" id="clock">Sun Nov 22 9:41 PM</time>
        </div>
      </div>

      <div class="dock" aria-hidden="true">
        {dockTiles.map((tile) => <span class={`tile ${tile}`}></span>)}
        <span class="divider"></span>
        <span class="tile trash"></span>
      </div>
    </div>
  </div>
  <div class="base" aria-hidden="true"><span class="lip"></span></div>
</figure>

<style>
  .mac {
    --menubar-fg: #1b1418;
    --strip-on: 0;

    margin: 0;
    width: 100%;
    container-type: inline-size;
    translate: 0 0;

    @media (prefers-reduced-motion: no-preference) {
      animation: rise 1.1s linear(0, 0.2 6%, 0.55 14%, 0.86 24%, 1.02 34%, 1.04 42%, 1.01 56%, 1) both;
    }
  }

  :global(body:has(#nightbar:checked)) .mac {
    --menubar-fg: #fff;
    --strip-on: 1;
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 6cqi;
      scale: 0.96;
    }
  }

  /* The lid: a thin black bezel around the display, with an aluminium rim. */
  .lid {
    padding: 1.6cqi 1.6cqi 1.3cqi;
    border-radius: 3.6cqi 3.6cqi 0.6cqi 0.6cqi;
    background: #050506;
    box-shadow:
      0 0 0 0.35cqi #9d9ca3,
      0 0 0 0.45cqi #5d5c63,
      0 4cqi 10cqi -2cqi rgb(0 0 0 / 0.6),
      0 1.5cqi 3cqi rgb(0 0 0 / 0.35);
  }

  .display {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 1.3cqi 1.3cqi 0 0;
    isolation: isolate;
  }

  /* The wallpaper is light at the top, so the transparent menu bar has dark icons. */
  .wallpaper {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(40% 32% at 72% 26%, rgb(255 236 214 / 0.95), transparent 70%),
      radial-gradient(70% 60% at 20% 0%, rgb(255 226 236 / 0.9), transparent 70%),
      linear-gradient(180deg, #fbe7dc 0%, #f4c3a8 34%, #d9898f 58%, #8f4a69 78%, #4c2440 100%);
  }

  .hills {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hill.far {
    fill: #6d3253;
    opacity: 0.75;
  }

  .hill.near {
    fill: #2a1424;
  }

  /* The menu bar is as tall as the notch, and split around it. */
  .menubar {
    --height: 2.25cqi;

    position: absolute;
    inset: 0 0 auto;
    height: var(--height);
    display: flex;
    align-items: center;
    padding-inline: 1.4cqi 1.1cqi;
    color: var(--menubar-fg);
    font-size: 0.95cqi;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color 0.45s ease;
  }

  .strip {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #000;
    translate: 0 calc((var(--strip-on) - 1) * 101%);
    transition: translate 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);

    @media (prefers-reduced-motion: reduce) {
      translate: 0 0;
      opacity: var(--strip-on);
      transition: opacity 0.3s ease;
    }
  }

  .menus,
  .extras {
    flex: 1;
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 1.35cqi;
    overflow: hidden;
    white-space: nowrap;
  }

  .app {
    font-weight: 700;
  }

  .extras {
    justify-content: flex-end;
    gap: 1.25cqi;
  }

  .notch {
    flex: none;
    position: relative;
    width: 12.2cqi;
    height: 100%;
    margin-inline: 2cqi;
    background: #000;
    border-radius: 0 0 0.75cqi 0.75cqi;

    /* The camera, a little right of centre. */
    &::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0.4cqi;
      aspect-ratio: 1;
      border-radius: 50%;
      translate: -50% -50%;
      background: radial-gradient(circle at 35% 35%, #2a2c3a, #0b0b10 70%);
    }
  }

  .icon {
    display: block;
    height: 1cqi;
    width: auto;
    overflow: visible;
  }

  .icon.battery {
    height: 0.85cqi;
  }

  .icon.control .knob {
    fill: #fff;
    transition: fill 0.45s ease;
  }

  :global(body:has(#nightbar:checked)) .icon.control .knob {
    fill: #000;
  }

  .clock {
    font-variant-numeric: tabular-nums;
  }

  /* Hide the menus that would run into the notch on narrow screens. */
  @container (max-width: 520px) {
    .menu-4,
    .menu-5,
    .icon.search {
      display: none;
    }
  }

  @container (max-width: 380px) {
    .menu-2,
    .menu-3,
    .icon.battery {
      display: none;
    }
  }

  .dock {
    position: absolute;
    left: 50%;
    bottom: 0.4cqi;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 0.6cqi;
    padding: 0.55cqi 0.65cqi;
    border-radius: 1.6cqi;
    background: rgb(255 255 255 / 0.2);
    backdrop-filter: blur(12px) saturate(1.6);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.35),
      0 1cqi 3cqi rgb(0 0 0 / 0.25);

    @media (prefers-reduced-transparency: reduce) {
      background: rgb(60 40 56 / 0.92);
      backdrop-filter: none;
    }
  }

  .tile {
    width: 2.6cqi;
    aspect-ratio: 1;
    border-radius: 0.65cqi;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }

  .tile.finder { background: linear-gradient(90deg, #4fb0ff 50%, #dff1ff 50%); }
  .tile.mail { background: linear-gradient(180deg, #5ec2ff, #1a74f0); }
  .tile.music { background: linear-gradient(180deg, #ff6b81, #f5214a); }
  .tile.photos { background: conic-gradient(#ffcd3c, #ff7a45, #e94bc1, #6d7bff, #39c5ff, #5fd76a, #ffcd3c); }
  .tile.notes { background: linear-gradient(180deg, #ffd84d 28%, #fffbea 28%); }
  .tile.nightbar { background: url("/icon.svg") center / cover; }
  .tile.safari { background: radial-gradient(circle, #fff 18%, #3aa0ff 20%, #1564e0 70%); }
  .tile.messages { background: linear-gradient(180deg, #6ae36f, #2bbd3a); }
  .tile.maps { background: linear-gradient(135deg, #8fd88a 45%, #f6d36b 45% 55%, #6bb7f5 55%); }
  .tile.facetime { background: linear-gradient(180deg, #67e16b, #22b232); }
  .tile.calendar { background: linear-gradient(180deg, #ff3b30 26%, #fff 26%); }
  .tile.tv { background: linear-gradient(180deg, #2a2a2e, #0b0b0d); }
  .tile.appstore { background: linear-gradient(180deg, #4fb6ff, #1677ee); }
  .tile.trash { background: linear-gradient(180deg, rgb(255 255 255 / 0.75), rgb(210 214 222 / 0.6)); }

  .divider {
    width: 1px;
    height: 2.2cqi;
    margin-inline: 0.2cqi;
    background: rgb(255 255 255 / 0.4);
  }

  .tile.settings { background: radial-gradient(circle, #8c8c93 30%, #c9c9cf 32%, #6f6f76 70%); }

  /* The base of the laptop, with the notch in its front edge. */
  .base {
    position: relative;
    width: 114%;
    height: 2.3cqi;
    margin-left: -7%;
    border-radius: 0.4cqi 0.4cqi 3cqi 3cqi / 0.4cqi 0.4cqi 2cqi 2cqi;
    background: linear-gradient(180deg, #4a484f 0%, #2b2a2f 40%, #17161a 100%);
    box-shadow: 0 2.5cqi 5cqi -1cqi rgb(0 0 0 / 0.7);
  }

  .lip {
    position: absolute;
    left: 50%;
    top: 0;
    width: 16%;
    height: 45%;
    translate: -50% 0;
    border-radius: 0 0 1.2cqi 1.2cqi;
    background: linear-gradient(180deg, #1b1a1e, #2a292e);
  }
</style>

<script>
  // Show the visitor's own day and time in the menu bar, the way macOS does.
  const clock = document.getElementById("clock");
  const format = new Intl.DateTimeFormat(undefined, {
    weekday: "short",
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });

  function tick() {
    if (clock) clock.textContent = format.format(new Date()).replace(/,/g, "");
  }

  tick();
  setInterval(tick, 15_000);
</script>
