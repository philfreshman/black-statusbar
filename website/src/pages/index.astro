---
import MacDesktop from "../components/MacDesktop.astro";

const repo = "philfreshman/nightbar";
const downloadUrl = `https://github.com/${repo}/releases/latest/download/Nightbar.zip`;
const description = "A small macOS app that keeps the menu bar black with white icons on every wallpaper.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Nightbar</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c090d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <meta property="og:title" content="Nightbar" />
    <meta property="og:description" content="Black menu bar. Any wallpaper." />
    <meta property="og:url" content="https://nightbar.app" />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <main>
      <section class="copy">
        <div class="brand"><img src="/icon.svg" alt="" width="36" height="36" />Nightbar</div>
        <h1>Black menu bar.<br />Any wallpaper.</h1>
        <p class="lede">
          A small macOS app that puts a black strip behind the menu bar, so it stays black with white icons on every
          wallpaper.
        </p>

        <div class="actions">
          <a class="download" id="download" href={downloadUrl}>Download</a>
          <label class="toggle">
            <input id="nightbar" type="checkbox" switch role="switch" />
            <span>Nightbar</span>
          </label>
        </div>

        <p class="meta"><span id="meta">macOS 14 or later</span> · <a href={`https://github.com/${repo}`}>GitHub</a></p>
      </section>

      <section class="visual">
        <MacDesktop />
      </section>
    </main>

    <style is:global>
      :root {
        --text: #f5e9e1;
        --muted: rgb(245 233 225 / 0.64);
        --peach: #eeaa86;
        --bg: #0c090d;

        color-scheme: dark;
        font: 100% / 1.5 system-ui, -apple-system, "SF Pro Text", "Inter", "Segoe UI", sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        color: var(--text);
        background:
          radial-gradient(60% 70% at 78% 45%, rgb(181 99 122 / 0.28), transparent 70%),
          radial-gradient(40% 40% at 85% 20%, rgb(240 174 134 / 0.16), transparent 70%),
          var(--bg);
      }

      :focus-visible {
        outline: 2px solid var(--text);
        outline-offset: 3px;
      }
    </style>

    <style>
      main {
        min-height: 100dvh;
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        align-items: center;
        gap: clamp(2rem, 5vw, 5rem);
        max-width: 84rem;
        margin-inline: auto;
        padding: 3rem clamp(1.25rem, 5vw, 4.5rem);

        @media (width < 56rem) {
          grid-template-columns: minmax(0, 1fr);
          align-content: center;
          gap: 3rem;
        }
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -0.01em;

        img {
          border-radius: 22%;
          box-shadow: 0 4px 14px rgb(0 0 0 / 0.4);
        }
      }

      h1 {
        margin: 1.75rem 0 1rem;
        font-size: clamp(2.4rem, 4.6vw, 4rem);
        line-height: 1.04;
        letter-spacing: -0.035em;
        font-weight: 800;
        text-wrap: balance;
      }

      .lede {
        margin: 0;
        max-width: 28rem;
        font-size: clamp(1.05rem, 1.4vw, 1.2rem);
        line-height: 1.55;
        color: var(--muted);
        text-wrap: pretty;
      }

      .actions {
        margin-top: 2.25rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .download {
        display: inline-flex;
        align-items: center;
        height: 3.25rem;
        padding-inline: 1.75rem;
        border-radius: 999px;
        background: var(--peach);
        color: #1d0f14;
        text-decoration: none;
        font-size: 1.1rem;
        font-weight: 700;
        box-shadow: 0 10px 28px rgb(0 0 0 / 0.3);
        transition:
          scale 0.1s ease-out,
          filter 0.15s ease;

        &:hover {
          filter: brightness(1.06);
        }

        &:active {
          scale: 0.97;
        }
      }

      .toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-weight: 600;
        cursor: pointer;
        user-select: none;
      }

      /* One look in every browser: the native switch only exists in Safari. */
      input[type="checkbox"][switch] {
        appearance: none;
        position: relative;
        flex: none;
        width: 3.5rem;
        height: 2rem;
        margin: 0;
        border-radius: 999px;
        background: rgb(255 255 255 / 0.2);
        box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
        cursor: pointer;
        transition: background-color 0.3s ease;

        &::before {
          content: "";
          position: absolute;
          top: 0.1875rem;
          left: 0.1875rem;
          width: 1.625rem;
          height: 1.625rem;
          border-radius: 50%;
          background: #fff;
          box-shadow: 0 2px 6px rgb(0 0 0 / 0.35);
          transition: translate 0.35s ease-out;
          transition-timing-function: linear(0, 0.33 10%, 0.72 24%, 0.94 40%, 1.01 56%, 1);
        }

        &:checked {
          background: #000;
          box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
        }

        &:checked::before {
          translate: 1.5rem 0;
        }

        &:active::before {
          scale: 1.06 0.94;
        }

        &:focus-visible {
          outline: 2px solid var(--text);
          outline-offset: 4px;
        }

        @media (prefers-reduced-motion: reduce) {
          &::before {
            transition: none;
          }
        }
      }

      .meta {
        margin: 2.5rem 0 0;
        font-size: 0.875rem;
        color: var(--muted);

        a {
          color: inherit;
          text-underline-offset: 3px;

          &:hover {
            color: var(--text);
          }
        }
      }

      .visual {
        min-width: 0;
      }
    </style>

    <script>
      const toggle = document.getElementById("nightbar") as HTMLInputElement;

      // Show the effect once: the switch turns on by itself shortly after the page loads,
      // unless the visitor got to it first or prefers less motion.
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      let touched = false;
      toggle.addEventListener("change", () => (touched = true), { once: true });

      if (reduceMotion) {
        toggle.checked = true;
      } else {
        // Wait until the Mac is on screen, so phones see the effect after scrolling to it.
        const observer = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            setTimeout(() => {
              if (!touched) toggle.checked = true;
            }, 1400);
          },
          { threshold: 0.6 },
        );
        observer.observe(document.querySelector(".mac")!);
      }

      // Point the button at the latest release's zip, or at the releases page while
      // there is no release yet.
      const repo = "philfreshman/nightbar";
      fetch(`https://api.github.com/repos/${repo}/releases/latest`)
        .then((res) => {
          if (res.status === 404) return null;
          if (!res.ok) throw new Error(`GitHub API ${res.status}`);
          return res.json();
        })
        .then((release) => {
          const button = document.getElementById("download") as HTMLAnchorElement;
          if (!release) {
            button.href = `https://github.com/${repo}/releases`;
            return;
          }
          const asset = (release.assets ?? []).find((a: { name: string }) => /\.zip$/i.test(a.name));
          if (asset) button.href = asset.browser_download_url;
          document.getElementById("meta")!.textContent =
            `Version ${release.tag_name.replace(/^v/, "")} · macOS 14 or later`;
        })
        .catch(() => {});
    </script>
  </body>
</html>
