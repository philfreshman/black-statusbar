---
import MacDesktop from "../components/MacDesktop.astro";

const repo = "philfreshman/nightbar";
const downloadUrl = `https://github.com/${repo}/releases/latest/download/Nightbar.zip`;
const description = "A small macOS app that keeps the menu bar black with white icons on every wallpaper.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Nightbar</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c090d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <meta property="og:title" content="Nightbar" />
    <meta property="og:description" content="Black menu bar. Any wallpaper." />
    <meta property="og:url" content="https://nightbar.app" />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <div class="orbs" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    <main>
      <section class="copy glass">
        <div class="brand"><img src="/icon.svg" alt="" width="36" height="36" />Nightbar</div>
        <h1>Black menu bar.<br />Any wallpaper.</h1>
        <p class="lede">
          A small macOS app that puts a black strip behind the menu bar, so it stays black with white icons on every
          wallpaper.
        </p>

        <label class="row glass">
          <span>Black menu bar</span>
          <input id="nightbar" type="checkbox" switch role="switch" />
        </label>

        <div class="actions">
          <a class="button prominent" id="download" href={downloadUrl}>Download</a>
          <a class="button glass" href={`https://github.com/${repo}`}>GitHub</a>
        </div>

        <p class="meta" id="meta">macOS 14 or later</p>
      </section>

      <section class="visual glass">
        <MacDesktop />
      </section>
    </main>

    <style is:global>
      :root {
        --text: #f5e9e1;
        --muted: rgb(245 233 225 / 0.64);
        --peach: #eeaa86;
        --bg: #0c090d;

        color-scheme: dark;
        font: 100% / 1.5 system-ui, -apple-system, "SF Pro Text", "Inter", "Segoe UI", sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        color: var(--text);
        background: var(--bg);
      }

      /* Soft colour behind everything, so the glass has something to blur. */
      .orbs {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        filter: blur(70px) saturate(1.2);

        span {
          position: absolute;
          border-radius: 50%;
          opacity: 0.75;
        }

        span:nth-child(1) { width: 46vmax; aspect-ratio: 1; left: -10vmax; top: -14vmax; background: #b5637a; }
        span:nth-child(2) { width: 40vmax; aspect-ratio: 1; right: -8vmax; top: 4vmax; background: #eeaa86; opacity: 0.55; }
        span:nth-child(3) { width: 38vmax; aspect-ratio: 1; left: 30vmax; bottom: -20vmax; background: #5e2d4f; }
        span:nth-child(4) { width: 26vmax; aspect-ratio: 1; right: 22vmax; bottom: 6vmax; background: #6b5bd6; opacity: 0.4; }

        @media (prefers-reduced-motion: no-preference) {
          span { animation: drift 48s ease-in-out infinite alternate; }
          span:nth-child(2) { animation-duration: 62s; animation-direction: alternate-reverse; }
          span:nth-child(3) { animation-duration: 56s; }
          span:nth-child(4) { animation-duration: 70s; animation-direction: alternate-reverse; }
        }
      }

      @keyframes drift {
        to { translate: 6vmax 4vmax; }
      }

      /* Frosted glass: a translucent, blurred layer with a bright top edge where light catches it. */
      .glass {
        background: linear-gradient(180deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.04));
        -webkit-backdrop-filter: blur(28px) saturate(1.7);
        backdrop-filter: blur(28px) saturate(1.7);
        border: 1px solid rgb(255 255 255 / 0.14);
        box-shadow:
          inset 0 1px 0 rgb(255 255 255 / 0.28),
          inset 0 -1px 0 rgb(255 255 255 / 0.04),
          0 24px 60px -20px rgb(0 0 0 / 0.55);

        @media (prefers-reduced-transparency: reduce) {
          background: rgb(38 26 36);
          -webkit-backdrop-filter: none;
          backdrop-filter: none;
        }

        @media (prefers-contrast: more) {
          background: rgb(24 16 22);
          border-color: rgb(255 255 255 / 0.6);
        }
      }

      :focus-visible {
        outline: 2px solid var(--text);
        outline-offset: 3px;
      }
    </style>

    <style>
      main {
        min-height: 100dvh;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
        align-items: center;
        gap: clamp(1.5rem, 3vw, 3rem);
        max-width: 84rem;
        margin-inline: auto;
        padding: 3rem clamp(1.25rem, 5vw, 4.5rem);

        @media (width < 56rem) {
          grid-template-columns: minmax(0, 1fr);
          align-content: center;
          gap: 3rem;
        }
      }

      .copy {
        padding: clamp(1.75rem, 3.5vw, 3rem);
        border-radius: 2rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -0.01em;

        img {
          border-radius: 22%;
          box-shadow: 0 4px 14px rgb(0 0 0 / 0.4);
        }
      }

      h1 {
        margin: 1.75rem 0 1rem;
        font-size: clamp(2.3rem, 3.9vw, 3.6rem);
        line-height: 1.04;
        letter-spacing: -0.035em;
        font-weight: 800;
        text-wrap: balance;
      }

      .lede {
        margin: 0;
        max-width: 28rem;
        font-size: clamp(1.05rem, 1.4vw, 1.2rem);
        line-height: 1.55;
        color: var(--muted);
        text-wrap: pretty;
      }

      /* A settings row with a trailing switch, the way Apple places switches in a list. */
      .row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        max-width: 22rem;
        margin-top: 2rem;
        padding: 0.7rem 0.7rem 0.7rem 1.1rem;
        border-radius: 1.6rem;
        font-size: 1.0625rem;
        cursor: pointer;
        user-select: none;
      }

      /* The iOS 26 switch: a 63 x 28 pt track with a capsule thumb that swells into a lens while pressed. */
      input[type="checkbox"][switch] {
        --thumb-w: 2.3125rem;
        --inset: 0.125rem;

        appearance: none;
        position: relative;
        flex: none;
        width: 3.9375rem;
        height: 1.75rem;
        margin: 0;
        border-radius: 999px;
        background: rgb(120 120 128 / 0.36);
        cursor: pointer;
        transition: background-color 0.25s ease;

        &::before {
          content: "";
          position: absolute;
          top: var(--inset);
          left: var(--inset);
          width: var(--thumb-w);
          height: calc(100% - 2 * var(--inset));
          border-radius: 999px;
          background: #fff;
          box-shadow:
            0 3px 8px rgb(0 0 0 / 0.15),
            0 3px 1px rgb(0 0 0 / 0.06);
          transition:
            translate 0.3s ease-out,
            scale 0.2s ease-out,
            background-color 0.2s ease;
          transition-timing-function: linear(0, 0.33 10%, 0.72 24%, 0.94 40%, 1.01 56%, 1), ease-out, ease;
        }

        &:checked {
          background: #30d158;
        }

        &:checked::before {
          translate: calc(3.9375rem - var(--thumb-w) - 2 * var(--inset)) 0;
        }

        &:active::before {
          scale: 1.3 1.45;
          background: rgb(255 255 255 / 0.55);
          box-shadow:
            inset 0 1px 1px rgb(255 255 255 / 0.9),
            inset 0 -1px 2px rgb(0 0 0 / 0.12),
            0 4px 12px rgb(0 0 0 / 0.2);
        }

        &:focus-visible {
          outline: 2px solid var(--text);
          outline-offset: 3px;
        }

        @media (prefers-reduced-motion: reduce) {
          &::before {
            transition: background-color 0.2s ease;
          }
        }
      }

      .actions {
        margin-top: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      /* Capsule buttons, large size: 17 pt semibold labels. */
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3.125rem;
        min-width: 7.5rem;
        padding-inline: 1.5rem;
        border-radius: 999px;
        color: var(--text);
        text-decoration: none;
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        transition:
          scale 0.2s ease-out,
          filter 0.15s ease;

        &:hover {
          filter: brightness(1.08);
        }

        &:active {
          scale: 0.96;
        }
      }

      /* Glass prominent: the accent colour on a glass capsule with a lit top edge. */
      .button.prominent {
        background: linear-gradient(180deg, rgb(10 132 255 / 0.92), rgb(0 110 230 / 0.92));
        -webkit-backdrop-filter: blur(20px) saturate(1.8);
        backdrop-filter: blur(20px) saturate(1.8);
        color: #fff;
        box-shadow:
          inset 0 1px 0.5px rgb(255 255 255 / 0.55),
          inset 0 -1px 1px rgb(0 0 0 / 0.15),
          0 8px 24px -8px rgb(10 132 255 / 0.6);
      }

      /* Regular glass: no tint, so the label takes the text colour. */
      .button.glass {
        box-shadow:
          inset 0 1px 0.5px rgb(255 255 255 / 0.35),
          inset 0 -1px 1px rgb(255 255 255 / 0.06),
          0 8px 24px -10px rgb(0 0 0 / 0.5);
      }

      .meta {
        margin: 1.5rem 0 0 0.25rem;
        font-size: 0.875rem;
        color: var(--muted);
      }

      .visual {
        min-width: 0;
        padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.75rem, 4vw, 3.5rem) clamp(1.75rem, 3.5vw, 3rem);
        border-radius: 2rem;
      }
    </style>

    <script>
      const toggle = document.getElementById("nightbar") as HTMLInputElement;

      // Show the effect once: the switch turns on by itself shortly after the page loads,
      // unless the visitor got to it first or prefers less motion.
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      let touched = false;
      toggle.addEventListener("change", () => (touched = true), { once: true });

      if (reduceMotion) {
        toggle.checked = true;
      } else {
        // Wait until the Mac is on screen, so phones see the effect after scrolling to it.
        const observer = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            setTimeout(() => {
              if (!touched) toggle.checked = true;
            }, 1400);
          },
          { threshold: 0.6 },
        );
        observer.observe(document.querySelector(".mac")!);
      }

      // Point the button at the latest release's zip, or at the releases page while
      // there is no release yet.
      const repo = "philfreshman/nightbar";
      fetch(`https://api.github.com/repos/${repo}/releases/latest`)
        .then((res) => {
          if (res.status === 404) return null;
          if (!res.ok) throw new Error(`GitHub API ${res.status}`);
          return res.json();
        })
        .then((release) => {
          const button = document.getElementById("download") as HTMLAnchorElement;
          if (!release) {
            button.href = `https://github.com/${repo}/releases`;
            return;
          }
          const asset = (release.assets ?? []).find((a: { name: string }) => /\.zip$/i.test(a.name));
          if (asset) button.href = asset.browser_download_url;
          document.getElementById("meta")!.textContent =
            `Version ${release.tag_name.replace(/^v/, "")} · macOS 14 or later`;
        })
        .catch(() => {});
    </script>
  </body>
</html>
