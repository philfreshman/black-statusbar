{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/philfreshman/nightbar/releases/latest/download/Nightbar.zip",
      "permanent": false
    },
    {
      "source": "/github",
      "destination": "https://github.com/philfreshman/nightbar",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
